---
import '../../styles/global.css';
import AppointmentRequest from '../../components/AppointmentRequest.astro';
const email = 'contacto@juanlurodriguez.com';
const portrait = 'https://pub-6b5e631a2e94415a999c6c8f9c26b7a3.r2.dev/juanlu.png';
const description = 'English-speaking physiotherapist in Inca, Mallorca. Juanlu Rodríguez offers individual physiotherapy for adults in his practice, at home and online. First session 60 €; follow-up 55 €; online 40 €.';
const mailto = `mailto:${email}?subject=${encodeURIComponent('Physiotherapy appointment request')}&body=${encodeURIComponent('Hello Juanlu, I would like to request an appointment.\n\nName:\nAppointment type (in person in Inca / home visit / online):\nTown (for a home visit):\nAvailability:\n\nI understand that the date and time are subject to confirmation. Thank you.')}`;
let booking = '';
try {
  const url = new URL(import.meta.env.PUBLIC_PATIENT_BOOKING_URL || '');
  if (url.protocol === 'https:' && ['cal.com', 'app.cal.com', 'cal.eu', 'app.cal.eu'].includes(url.hostname) && url.pathname !== '/' && !url.username && !url.password) booking = url.href;
} catch {}
const schema = { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://juanlurodriguez.com/#juanlu', name: 'Juan Luis Rodríguez Ávila', alternateName: 'Juanlu Rodríguez', jobTitle: 'Physiotherapist', url: 'https://juanlurodriguez.com/en/', image: portrait, email, knowsLanguage: ['es', 'en'], knowsAbout: ['Musculoskeletal physiotherapy', 'Manual therapy', 'Therapeutic exercise', 'Dry needling', 'Electrical dry needling'] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#263e35" />
    <title>English-speaking physiotherapist in Inca · Juanlu Rodríguez</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://juanlurodriguez.com/en/" />
    <link rel="alternate" hreflang="es" href="https://juanlurodriguez.com/" />
    <link rel="alternate" hreflang="en" href="https://juanlurodriguez.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://juanlurodriguez.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content="English-speaking physiotherapist in Inca · Juanlu Rodríguez" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://juanlurodriguez.com/en/" />
    <meta property="og:image" content={portrait} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="#start" aria-label="Juanlu Rodríguez, home">Juanlu Rodríguez<span>PHYSIOTHERAPY</span></a>
      <nav aria-label="Main navigation"><a href="#approach">My approach</a><a href="#sessions">Sessions & fees</a><a class="language-link" href="/" lang="es" hreflang="es">Español</a><a class="nav-cta" href="#contact">Contact <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="content">
      <section id="start" class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot"></span> PHYSIOTHERAPY IN INCA · MALLORCA</p>
          <h1>Understand your pain.<br /><em>Move forward.</em></h1>
          <p class="intro">English-speaking physiotherapist for adults at my practice in Inca. Support with pain, rehabilitation and recovery of movement and everyday function.</p>
          <p class="hero-note">Individual assessment, treatment adapted to you and clear exercise guidance to continue between sessions.</p>
          <div class="actions"><a class="button" href="#contact">Request an appointment <span aria-hidden="true">↗</span></a><a class="text-link" href="#sessions">Sessions & fees <span aria-hidden="true">↓</span></a></div>
          <p class="micro">In-person appointments in Inca. Home visits and online sessions also available.<br />Consultations in English and Spanish, by appointment.</p>
        </div>
        <div class="portrait-block">
          <div class="portrait-frame"><img src={portrait} alt="Juanlu Rodríguez, physiotherapist in Inca" width="800" height="1000" fetchpriority="high" /></div>
          <div class="portrait-caption"><span>Juan Luis Rodríguez Ávila</span><span>Physiotherapist · Registration no. 2498</span></div>
          <span class="portrait-word" aria-hidden="true">Movement.</span>
        </div>
      </section>
      <div class="credentials"><div class="wrap credential-row"><span>INDIVIDUAL CARE</span><span>MUSCULOSKELETAL PHYSIOTHERAPY</span><span>ADULTS</span></div></div>
      <section id="approach" class="section wrap">
        <div class="section-heading"><p class="eyebrow">MY APPROACH</p><h2>Three tools.<br /><em>A plan for you.</em></h2><p>Your assessment guides treatment. We choose the techniques that fit your needs and combine them with an active role in your recovery.</p></div>
        <div class="approaches">
          <article><span class="number">01 /</span><h3>Manual therapy</h3><p>Hands-on treatment for muscles and joints, adapted to your symptoms and the findings of your assessment.</p></article>
          <article><span class="number">02 /</span><h3>Therapeutic exercise</h3><p>Exercises tailored to your needs and goals, with guidance on how to continue between appointments.</p></article>
          <article><span class="number">03 /</span><h3>Dry needling</h3><p>Dry needling and electrical dry needling when appropriate, after assessment, an explanation of the procedure and your consent.</p></article>
        </div>
      </section>
      <section id="sessions" class="prices-section"><div class="wrap section">
        <div class="section-heading compact"><p class="eyebrow">SESSIONS & FEES</p><h2>Clear information.<br /><em>From your first visit.</em></h2></div>
        <div class="tariff-scroll" role="region" aria-label="Physiotherapy fees" tabindex="0">
          <table class="tariff-table">
            <caption>Physiotherapy sessions and supplements</caption>
            <thead><tr><th scope="col">Service</th><th scope="col">Fee</th><th scope="col">What's included</th></tr></thead>
            <tbody>
              <tr><th scope="row"><a href="#contact" data-request="clinic-first">First in-person session ↗</a></th><td class="tariff-amount">60 €</td><td>Approximately 55 minutes. Initial assessment, treatment and an exercise plan.</td></tr>
              <tr><th scope="row"><a href="#contact" data-request="clinic-follow">In-person follow-up ↗</a></th><td class="tariff-amount">55 €</td><td>Approximately 55 minutes. Review, treatment and adjustments to your exercise guidance.</td></tr>
              <tr><th scope="row"><a href="#contact" data-request="online">Online session ↗</a></th><td class="tariff-amount">40 €</td><td>Assessment, advice, therapeutic exercise and follow-up by video call. Duration agreed before confirmation.</td></tr>
              <tr><th scope="row"><a href="#contact" data-request="home">Home visit ↗</a></th><td>60 € first session / 55 € follow-up<br /><span class="tariff-extra">+ travel supplement</span></td><td>The supplement considers the return distance and travel time from Inca. The full price is quoted before you confirm.</td></tr>
              <tr><th scope="row">Outside usual hours</th><td>By quotation</td><td>Outside 08:00–20:00, subject to availability and a quotation agreed in advance.</td></tr>
            </tbody>
          </table>
        </div>
        <p class="pricing-note">The first in-person session includes assessment and treatment. After six months without an appointment, a new assessment is charged at the first-session rate (60 €).</p>
        <p class="pricing-note">Private care for adults. Techniques are selected after assessment. Any supplements are agreed before confirmation.</p>
        <div class="tariff-contact"><a class="button" href="#contact">Ask about availability <span aria-hidden="true">↗</span></a><p>Usually between 08:00 and 20:00, by appointment and subject to availability.<br />This does not mean continuous availability every day.</p></div>
      </div></section>
      <section class="section wrap about" id="about">
        <div><p class="eyebrow">YOUR PHYSIOTHERAPIST</p><h2>I'm Juanlu.<br /><em>Here to support you.</em></h2></div>
        <div class="about-copy"><p class="lead">I'm Juan Luis Rodríguez Ávila, a physiotherapist registered under number 2498. My practice focuses on adult musculoskeletal care: pain, rehabilitation and functional recovery.</p><p>I currently work in primary care at IB-Salut. Previously, I worked at Hospital Universitario Son Llàtzer.</p><p>I combine manual therapy, therapeutic exercise and, when indicated, dry needling and electrical dry needling. Sessions include assessment, treatment and practical guidance for what you can do next.</p><a class="text-link" href="https://www.doctoralia.es/perfil/juan-luis-rodriguez-avila">My Doctoralia profile (in Spanish) <span aria-hidden="true">↗</span></a></div>
      </section>
      <section class="section wrap faq"><div><p class="eyebrow">BEFORE YOUR VISIT</p><h2>The essentials.<br /><em>Before we start.</em></h2></div><div class="questions">
        <details><summary>How do I request an appointment?</summary><p>Use the form below to prepare an email with your name, preferred appointment type and availability. For a home visit, include your town. You can open it in Gmail, Outlook or your email app, or copy it and send it to contacto@juanlurodriguez.com. Preparing a request does not send it. Your appointment is confirmed only after we agree the date and time.</p></details>
        <details><summary>Where is your practice?</summary><p>My practice is on Carrer Vicenç Ensenyat, Inca, Mallorca (07300). You will receive access directions when your appointment is confirmed. All visits are by appointment.</p></details>
        <details><summary>Can I have my consultation in English?</summary><p>Yes. I offer consultations in English and Spanish, in person in Inca, at home and online.</p></details>
        <details><summary>Do you offer home visits?</summary><p>Yes, subject to availability. Include your town in your request. The session fee plus a travel supplement based on the return distance and travel time from Inca will be quoted before confirmation.</p></details>
        <details><summary>When can I book? Can I ask for an appointment today?</summary><p>Usual hours are 08:00–20:00, by appointment and subject to availability. Same-day requests are welcome, but a slot cannot be guaranteed. Appointments outside those hours require availability and a quotation in advance. No surcharge has been set for requests made less than 24 hours ahead.</p></details>
        <details><summary>What happens at the first session?</summary><p>We start with an assessment, continue with appropriate treatment and finish with exercises and guidance. In-person sessions last approximately 55 minutes.</p></details>
        <details><summary>Is dry needling always used?</summary><p>No. Dry needling and electrical dry needling are optional tools used when indicated after assessment, an explanation and your consent.</p></details>
        <details><summary>What can an online session cover?</summary><p>Assessment, advice, exercise guidance and follow-up by video call. The duration and connection method are agreed before confirmation. If in-person care is more suitable, we will discuss it.</p></details>
        <details><summary>Who do you treat?</summary><p>Adults with musculoskeletal problems. I do not offer specific pelvic health, oncology, neurological, paediatric or specialist disability rehabilitation services.</p></details>
      </div></section>
      <section class="contact-section" id="contact"><div class="wrap contact-inner"><p class="eyebrow">YOUR FIRST STEP</p><h2>Tell me when<br /><em>works for you.</em></h2><p>In-person appointments on Carrer Vicenç Ensenyat, Inca (07300).<br />Home visits and online sessions are also available.</p><AppointmentRequest lang="en" />{booking && <a class="calendar-link" href={booking}>Choose a calendar slot ↗</a>}<a class="email-address" href={mailto}>{email}</a><p class="micro">You can also email me directly.<br />No medical reports or clinical information are needed to request an appointment.</p></div></section>
    </main>
    <footer class="wrap footer"><div><a class="brand" href="#start">Juanlu Rodríguez<span>PHYSIOTHERAPY · REGISTRATION NO. 2498</span></a><p>Inca, Mallorca · Home visits · Online<br />Consultations in English and Spanish</p></div><div><a href="/" lang="es" hreflang="es">Versión en español ↗</a></div></footer>
    <a class="mobile-cta" href="#contact">Request an appointment <span aria-hidden="true">↗</span></a>
  </body>
</html>
